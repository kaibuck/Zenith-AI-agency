# ─── SignalWire ──────────────────────────────────────────────────────────────
# Find these in your SignalWire dashboard → API Credentials
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here
SIGNALWIRE_SPACE=your-space.signalwire.com
SIGNALWIRE_PHONE_NUMBER=+15551234567

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Google Calendar ──────────────────────────────────────────────────────────
# 1. Create credentials at console.cloud.google.com → APIs & Services → Credentials
# 2. Enable the Google Calendar API
# 3. Start the server, visit /admin, go to Settings → Connect Google Calendar
# 4. Copy the refresh token from the callback page and paste it below
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token_after_oauth
GOOGLE_CALENDAR_ID=primary

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=https://your-domain.com
SESSION_SECRET=change-this-to-a-random-string-32-chars
ADMIN_PASSWORD=changeme

# ─── Business ────────────────────────────────────────────────────────────────
# These can also be edited live in the Admin Dashboard → Settings
BUSINESS_NAME=Sunrise Wellness Spa
BUSINESS_TAGLINE=Your relaxation destination
BUSINESS_TIMEZONE=America/New_York
OWNER_PHONE=+15559876543
OWNER_EMAIL=owner@example.com
TRANSFER_PHONE=+15559876543
