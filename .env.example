PORT=3000

# Vapi
VAPI_API_KEY=your_vapi_api_key

# Google Calendar
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=your_redirect_uri
GOOGLE_CALENDAR_ID=primary

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Owner
OWNER_PHONE_NUMBER=your_phone_number

# ─── Outbound Lead Agent ─────────────────────────────────────────────────────
# Public HTTPS URL of this server (Vapi calls back to $PUBLIC_BASE_URL/vapi/outbound)
PUBLIC_BASE_URL=https://your-server.example.com
# Protects /leads endpoints: send as header x-api-key
ADMIN_API_KEY=choose_a_long_random_string
# Optional: Vapi sends it as x-vapi-secret on webhooks
VAPI_WEBHOOK_SECRET=

# Vapi outbound phone number (import your Twilio number into Vapi, copy its ID)
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
# LLM that runs the call (must be a model Vapi supports)
VAPI_MODEL_PROVIDER=anthropic
VAPI_MODEL=claude-sonnet-5-5

# Lead search (Google Places API (New) key)
GOOGLE_PLACES_API_KEY=your_places_api_key
LEAD_SEARCH_QUERY=HVAC contractor
LEAD_SEARCH_LOCATION=Atlanta, GA

# Google Calendar booking (run `npm run google-auth` to get the refresh token)
GOOGLE_REFRESH_TOKEN=
MEETING_TIMEZONE=America/New_York
MEETING_DURATION_MINUTES=30
MEETING_DAY_START_HOUR=9
MEETING_DAY_END_HOUR=17

# What the AI caller says
AGENCY_NAME=Zenith AI Agency
AGENT_CALLER_NAME=Alex
OWNER_NAME=Kai
MEETING_PURPOSE=a 30-minute demo call
AGENCY_PITCH=We set up AI receptionists that answer every call 24/7, book jobs straight into your calendar, and text customers reminders, so you never lose a lead to voicemail.

# Calling limits & compliance
CALL_START_HOUR=9
CALL_END_HOUR=17
MAX_CALL_ATTEMPTS=2
MAX_CALLS_PER_DAY=50
CALLS_PER_RUN=3
# Comma-separated numbers to never call
DNC_NUMBERS=
# true = find leads and dial automatically every 15 min during calling hours
LEAD_AGENT_AUTORUN=false
